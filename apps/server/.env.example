# Legacy example retained for compatibility; use .env.template for new setups.
# Relative DATA_DIR paths resolve from apps/server (npm workspace working directory).
HOST=127.0.0.1
PORT=3000
DATA_DIR=../../var
LOG_LEVEL=info
# Must match the exact frontend origin; use HTTPS in production.
APP_ORIGIN=http://127.0.0.1:5173
# Development executes trusted repositories on this machine. Production requires docker.
BUILDER_RUNNER=local
# Docker: build the fixed image with `docker build -t builder-runtime:node24 -f tools/Dockerfile .`
BUILDER_IMAGE=builder-runtime:node24
# Docker production Git access requires a dedicated network with an operator-enforced
# egress policy blocking management/private networks and metadata endpoints.
BUILDER_GIT_NETWORK=none
BUILDER_BUILD_NETWORK=none
# SSH private-key encryption master key: generate with `openssl rand -base64 32`.
# Keep separately from database backups; losing it makes all stored private keys unusable.
BUILDER_SECRET_KEY=
