# 开发镜像：只含运行环境，源码通过 bind mount 挂入，依赖在命名卷中。
ARG NODE_IMAGE=node:24-bookworm-slim
ARG DOCKER_CLI_IMAGE=docker:29.1.3-cli

FROM ${DOCKER_CLI_IMAGE} AS docker-cli

FROM ${NODE_IMAGE} AS dev
ARG DEBIAN_MIRROR=deb.debian.org
RUN sed -i "s|http://deb.debian.org/|http://${DEBIAN_MIRROR}/|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::http::Timeout=15 -o Acquire::Retries=2 update \
    && apt-get -o Acquire::http::Timeout=15 -o Acquire::Retries=2 install -y --no-install-recommends ca-certificates git openssh-client procps python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
ARG BUILDER_UID=1000
ARG BUILDER_GID=1000
RUN --mount=type=bind,source=deploy/ensure-builder-user.sh,target=/tmp/ensure-builder-user.sh \
    sh /tmp/ensure-builder-user.sh "$BUILDER_UID" "$BUILDER_GID"
# 命名卷首次创建时继承这些目录的属主，使非 root 用户可写入依赖。
RUN mkdir -p /app/node_modules /app/apps/server/node_modules /app/apps/web/node_modules \
    && chown -R "$BUILDER_UID:$BUILDER_GID" /app
ENV HOME=/tmp \
    npm_config_cache=/app/node_modules/.npm-cache \
    NODE_ENV=development
WORKDIR /app
USER ${BUILDER_UID}:${BUILDER_GID}
